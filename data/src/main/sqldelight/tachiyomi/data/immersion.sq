    :noteId,
    NULL,
    NULL,
    :type,
    :status,
    1,
    :expressionHash,
    :normalizedExpression,
    :normalizedReading,
    :occurredAt,
    'UNLINKED_AFTER_LOCAL_WRITE_FAILURE'
);

selectImmersionEventById:
SELECT *
FROM immersion_event
WHERE id = :id;

selectImmersionEventBySequence:
SELECT *
FROM immersion_event
WHERE session_id = :sessionId AND sequence = :sequence;

countImmersionSessionSourceExposure:
SELECT count(*)
FROM immersion_source_exposure
WHERE session_id = :sessionId AND source_unit_id = :sourceUnitId;

insertImmersionSourceExposure:
INSERT INTO immersion_source_exposure(
    event_id,
    session_id,
    source_unit_id,
    replay_ordinal,
    exposure_policy,
    gross_characters,
    unique_source_characters,
    active_duration_ms
)
VALUES (
    :eventId,
    :sessionId,
    :sourceUnitId,
    :replayOrdinal,
    :exposurePolicy,
    :grossCharacters,
    :uniqueSourceCharacters,
    :activeDurationMs
);

advanceImmersionSessionForExposure:
UPDATE immersion_session
SET
    active_duration_ms = active_duration_ms + :activeDurationDeltaMs,
    gross_characters = gross_characters + :grossCharacterDelta,
    unique_source_characters = unique_source_characters + :uniqueSourceCharacterDelta,
    net_characters = net_characters + :netCharacterDelta,
    source_unit_count = source_unit_count + :sourceUnitDelta,
    last_sequence = :sequence,
    last_heartbeat_at = max(coalesce(last_heartbeat_at, 0), :occurredAt)
WHERE
    id = :sessionId
    AND status = 'ACTIVE'
    AND last_sequence + 1 = :sequence;

advanceImmersionSessionForEvent:
UPDATE immersion_session
SET
    active_duration_ms = active_duration_ms + :activeDurationDeltaMs,
    net_characters = net_characters + :netCharacterDelta,
    last_sequence = :sequence,
    last_heartbeat_at = max(coalesce(last_heartbeat_at, 0), :occurredAt)
WHERE
    id = :sessionId
    AND status = 'ACTIVE'
    AND last_sequence + 1 = :sequence;

advanceImmersionSessionForInteraction:
UPDATE immersion_session
SET
    lookup_count = lookup_count + :lookupDelta,
    cards_created = cards_created + :cardsCreatedDelta,
    cards_updated = cards_updated + :cardsUpdatedDelta,
    last_sequence = :sequence,
    last_heartbeat_at = max(coalesce(last_heartbeat_at, 0), :occurredAt)
WHERE
    id = :sessionId
    AND status = 'ACTIVE'
    AND last_sequence + 1 = :sequence;

incrementImmersionRevision:
UPDATE immersion_rollup_state
SET revision = revision + 1, updated_at = :updatedAt
WHERE scope_key = 'global';

selectImmersionRevision:
SELECT revision
FROM immersion_rollup_state
WHERE scope_key = 'global';

selectImmersionChanges:
SELECT changes();

selectImmersionIndexWork:
SELECT
    source.id,
    source.title_id,
    source.source_kind,
    title.language_tag,
    title.profile_id,
    source.normalized_text_hash,
    source.raw_text,
    source.tokenizer_version,
    source.indexed_version,
    source.index_attempt_count
FROM immersion_source_unit AS source
JOIN immersion_title AS title ON title.id = source.title_id
WHERE
    source.indexed_version < :targetVersion
    AND source.indexing_status IN ('PENDING', 'FAILED')
    AND source.indexing_terminal_reason IS NULL
    AND (source.next_index_attempt_at IS NULL OR source.next_index_attempt_at <= :nowEpochMillis)
ORDER BY source.first_exposed_at, source.id
LIMIT :limit;

markImmersionIndexWorkClaimed:
UPDATE immersion_source_unit
SET
    indexing_status = 'IN_PROGRESS',
    index_error_code = NULL,
    next_index_attempt_at = NULL,
    index_attempt_count = index_attempt_count + 1
WHERE id IN :ids;

markImmersionSourceIndexed:
UPDATE immersion_source_unit
SET
    tokenizer_id = :tokenizerId,
    tokenizer_version = :tokenizerVersion,
    normalization_version = :normalizationVersion,
    tokenization_confidence = :tokenizationConfidence,
    indexed_version = :indexedVersion,
    indexing_status = CASE WHEN :terminalReason IS NULL THEN 'INDEXED' ELSE 'UNAVAILABLE' END,
    index_error_code = NULL,
    next_index_attempt_at = NULL,
    indexing_terminal_reason = :terminalReason,
    countable_characters = coalesce(:countableCharacters, countable_characters),
    han_characters = coalesce(:hanCharacters, han_characters),
    hiragana_characters = coalesce(:hiraganaCharacters, hiragana_characters),
    katakana_characters = coalesce(:katakanaCharacters, katakana_characters),
    hangul_characters = coalesce(:hangulCharacters, hangul_characters),
    latin_characters = coalesce(:latinCharacters, latin_characters),
    other_characters = coalesce(:otherCharacters, other_characters)
WHERE id = :id;

markImmersionSourceIndexFailed:
UPDATE immersion_source_unit
SET
    indexing_status = 'FAILED',
    index_error_code = :errorCode,
    next_index_attempt_at = :nextAttemptAt
WHERE id = :id;

deleteImmersionWordOccurrencesForSource:
DELETE FROM immersion_word_occurrence
WHERE source_unit_id = :sourceUnitId;

deleteImmersionCharacterOccurrencesForSource:
DELETE FROM immersion_character_occurrence
WHERE source_unit_id = :sourceUnitId;

recomputeImmersionWordSeenTimes:
UPDATE immersion_word
SET
    first_seen_at = (
        SELECT min(source.first_exposed_at)
        FROM immersion_word_occurrence AS occurrence
        JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
        WHERE occurrence.word_id = immersion_word.id
    ),
    last_seen_at = (
        SELECT max(source.last_exposed_at)
        FROM immersion_word_occurrence AS occurrence
        JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
        WHERE occurrence.word_id = immersion_word.id
    )
WHERE EXISTS (
    SELECT 1
    FROM immersion_word_occurrence AS occurrence
    WHERE occurrence.word_id = immersion_word.id
);

recomputeImmersionCharacterSeenTimes:
UPDATE immersion_character
SET
    first_seen_at = (
        SELECT min(source.first_exposed_at)
        FROM immersion_character_occurrence AS occurrence
        JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
        WHERE occurrence.character_code_point = immersion_character.code_point
    ),
    last_seen_at = (
        SELECT max(source.last_exposed_at)
        FROM immersion_character_occurrence AS occurrence
        JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
        WHERE occurrence.character_code_point = immersion_character.code_point
    )
WHERE EXISTS (
    SELECT 1
    FROM immersion_character_occurrence AS occurrence
    WHERE occurrence.character_code_point = immersion_character.code_point
);

deleteOrphanImmersionWords:
DELETE FROM immersion_word
WHERE NOT EXISTS (
    SELECT 1
    FROM immersion_word_occurrence AS occurrence
    WHERE occurrence.word_id = immersion_word.id
);

deleteOrphanImmersionCharacters:
DELETE FROM immersion_character
WHERE NOT EXISTS (
    SELECT 1
    FROM immersion_character_occurrence AS occurrence
    WHERE occurrence.character_code_point = immersion_character.code_point
);

requeueImmersionSourceUnits:
UPDATE immersion_source_unit
SET
    indexed_version = 0,
    indexing_status = 'PENDING',
    index_error_code = NULL,
    next_index_attempt_at = NULL,
    indexing_terminal_reason = NULL
WHERE
    (:titleId IS NULL OR title_id = :titleId)
    AND (:exposedFrom IS NULL OR last_exposed_at >= :exposedFrom)
    AND (:exposedUntil IS NULL OR first_exposed_at <= :exposedUntil)
    AND (
        :languageTag IS NULL OR EXISTS (
            SELECT 1
            FROM immersion_title AS title
            WHERE title.id = immersion_source_unit.title_id
                AND title.language_tag = :languageTag
        )
    );

countPendingImmersionSourceUnits:
SELECT count(*)
FROM immersion_source_unit
WHERE
    indexed_version < :targetVersion
    AND indexing_status IN ('PENDING', 'FAILED', 'IN_PROGRESS')
    AND indexing_terminal_reason IS NULL;

isImmersionIndexEntityExcluded:
SELECT count(*)
FROM immersion_exclusion
WHERE
    entity_type = :entityType
    AND entity_id = :entityId
    AND scope_key IN :scopeKeys;

upsertImmersionExclusion:
INSERT INTO immersion_exclusion(
    id,
    entity_type,
    entity_id,
    scope_key,
    reason,
    created_at
)
VALUES (:id, :entityType, :entityId, :scopeKey, :reason, :createdAt)
ON CONFLICT(entity_type, entity_id, scope_key) DO UPDATE SET
    reason = excluded.reason,
    created_at = excluded.created_at;

deleteImmersionExclusion:
DELETE FROM immersion_exclusion
WHERE entity_type = :entityType
    AND entity_id = :entityId
    AND scope_key = :scopeKey;

upsertImmersionTombstone:
INSERT INTO immersion_tombstone(
    entity_type,
    entity_id,
    deleted_at,
    device_id
)
VALUES (:entityType, :entityId, :deletedAt, :deviceId)
ON CONFLICT(entity_type, entity_id) DO UPDATE SET
    deleted_at = max(immersion_tombstone.deleted_at, excluded.deleted_at),
    device_id = CASE
        WHEN excluded.deleted_at >= immersion_tombstone.deleted_at THEN excluded.device_id
        ELSE immersion_tombstone.device_id
    END;

upsertImmersionWord:
INSERT INTO immersion_word(
    id,
    language_tag,
    normalized_headword,
    normalized_reading,
    display_headword,
    display_reading,
    part_of_speech,
    tokenization_confidence,
    frequency_corpus,
    frequency_rank,
    jlpt_level,
    grade_level,
    first_seen_at,
    last_seen_at
)
VALUES (
    :id,
    :languageTag,
    :normalizedHeadword,
    :normalizedReading,
    :displayHeadword,
    :displayReading,
    :partOfSpeech,
    :tokenizationConfidence,
    :frequencyCorpus,
    :frequencyRank,
    :jlptLevel,
    :gradeLevel,
    :firstSeenAt,
    :lastSeenAt
)
ON CONFLICT(language_tag, normalized_headword, normalized_reading) DO UPDATE SET
    display_headword = excluded.display_headword,
    display_reading = excluded.display_reading,
    part_of_speech = excluded.part_of_speech,
    tokenization_confidence = excluded.tokenization_confidence,
    frequency_corpus = coalesce(excluded.frequency_corpus, frequency_corpus),
    frequency_rank = coalesce(excluded.frequency_rank, frequency_rank),
    jlpt_level = coalesce(excluded.jlpt_level, jlpt_level),
    grade_level = coalesce(excluded.grade_level, grade_level),
    last_seen_at = max(last_seen_at, excluded.last_seen_at);

insertImmersionWordOccurrence:
INSERT OR REPLACE INTO immersion_word_occurrence(
    word_id,
    source_unit_id,
    token_ordinal,
    surface_text,
    source_start,
    source_end,
    deinflection_rule,
    tokenizer_version
)
VALUES (
    :wordId,
    :sourceUnitId,
    :tokenOrdinal,
    :surfaceText,
    :sourceStart,
    :sourceEnd,
    :deinflectionRule,
    :tokenizerVersion
);

upsertImmersionCharacter:
INSERT INTO immersion_character(
    code_point,
    rendered,
    unicode_name,
    unicode_category,
    unicode_script,
    first_seen_at,
    last_seen_at
)
VALUES (
    :codePoint,
    :rendered,
    :unicodeName,
    :unicodeCategory,
    :unicodeScript,
    :firstSeenAt,
    :lastSeenAt
)
ON CONFLICT(code_point) DO UPDATE SET
    last_seen_at = max(last_seen_at, excluded.last_seen_at);

insertImmersionCharacterOccurrence:
INSERT INTO immersion_character_occurrence(
    character_code_point,
    source_unit_id,
    occurrence_count,
    first_ordinal
)
VALUES (
    :characterCodePoint,
    :sourceUnitId,
    :occurrenceCount,
    :firstOrdinal
)
ON CONFLICT(character_code_point, source_unit_id) DO UPDATE SET
    occurrence_count = excluded.occurrence_count,
    first_ordinal = min(first_ordinal, excluded.first_ordinal);

selectImmersionOverview:
SELECT
    coalesce(sum(active_duration_ms), 0) AS active_duration_ms,
    coalesce(sum(gross_characters), 0) AS gross_characters,
    coalesce(sum(unique_source_characters), 0) AS unique_source_characters,
    coalesce(sum(net_characters), 0) AS net_characters,
    coalesce(sum(source_unit_count), 0) AS source_units,
    coalesce(sum(word_count), 0) AS words,
    coalesce(sum(lookup_count), 0) AS lookups,
    coalesce(sum(cards_created), 0) AS cards_created,
    coalesce(sum(cards_updated), 0) AS cards_updated,
    count(*) AS sessions
FROM immersion_session
WHERE status IN ('COMPLETED', 'ABANDONED');

selectImmersionIntegrityReport:
SELECT
    (
        SELECT count(*)
        FROM immersion_event AS event
        LEFT JOIN immersion_session AS session ON session.id = event.session_id
        WHERE session.id IS NULL
    ) AS orphaned_events,
    (
        SELECT count(*)
        FROM immersion_word_occurrence AS occurrence
        LEFT JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
        WHERE source.id IS NULL
    ) + (
        SELECT count(*)
        FROM immersion_character_occurrence AS occurrence
        LEFT JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
        WHERE source.id IS NULL
    ) AS orphaned_occurrences,
    (
        SELECT count(*)
        FROM (
            SELECT session_id, sequence
            FROM immersion_event
            GROUP BY session_id, sequence
            HAVING count(*) > 1
        )
    ) AS duplicate_session_sequences,
    (
        SELECT count(*)
        FROM immersion_session
        WHERE
            active_duration_ms < 0
            OR elapsed_duration_ms < 0
            OR paused_duration_ms < 0
            OR idle_duration_ms < 0
            OR buffering_duration_ms < 0
            OR gross_characters < 0
            OR unique_source_characters < 0
            OR word_count < 0
            OR source_unit_count < 0
            OR lookup_count < 0
            OR cards_created < 0
            OR cards_updated < 0
    ) AS negative_counters,
    (
        SELECT count(*)
        FROM immersion_daily_rollup
        WHERE rollup_version != :expectedRollupVersion
    ) + (
        SELECT count(*)
        FROM immersion_lifetime_rollup
        WHERE rollup_version != :expectedRollupVersion
    ) AS rollup_version_mismatches;

clearImmersionRollups:
DELETE FROM immersion_daily_rollup;

clearImmersionLifetimeRollups:
DELETE FROM immersion_lifetime_rollup;

clearImmersionAppliedEvents:
DELETE FROM immersion_applied_event;

updateImmersionRepairState:
UPDATE immersion_rollup_state
SET
    rollup_version = :rollupVersion,
    repair_cursor = :repairCursor,
    updated_at = :updatedAt,
    revision = revision + 1
WHERE scope_key = 'global';

selectImmersionAnalyticsDateBounds:
SELECT
    min(local_date) AS first_date,
    max(local_date) AS last_date
FROM immersion_daily_rollup
WHERE
    (:filterMediaKinds = 0 OR media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR language_tag IN :languageTags)
    AND (:filterTitleIds = 0 OR title_id IN :titleIds)
    AND (:includeLegacy = 1 OR provenance_state != 'LEGACY_AGGREGATE')
    AND (:filterProvenance = 0 OR provenance_state IN :provenanceStates)
    AND (:includeRereads = 1 OR replay_state = 'PRIMARY');

selectImmersionDailyRollups:
SELECT *
FROM immersion_daily_rollup
WHERE local_date BETWEEN :startDate AND :endDate
ORDER BY local_date, scope_key;

selectImmersionAnalyticsInventory:
WITH filtered_exposure AS (
    SELECT DISTINCT
        exposure.source_unit_id,
        event.occurred_at,
        session.title_id
    FROM immersion_source_exposure AS exposure
    JOIN immersion_event AS event ON event.id = exposure.event_id
    JOIN immersion_session AS session ON session.id = event.session_id
    WHERE
        session.status != 'DELETED'
        AND (
            :filterDate = 0
            OR event.local_date BETWEEN :startDate AND :endDate
        )
        AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
        AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
        AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
        AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
        AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
        AND (:includeLegacy = 1 OR session.legacy_import = 0)
        AND (
            :filterProvenance = 0
            OR (
                session.legacy_import = 1
                AND 'LEGACY_AGGREGATE' IN :provenanceStates
            )
            OR (
                session.legacy_import = 0
                AND 'AVAILABLE' IN :provenanceStates
            )
        )
),
word_metrics AS (
    SELECT
        count(DISTINCT word.id) AS unique_words,
        count(DISTINCT CASE
            WHEN word.first_seen_at = filtered_exposure.occurred_at THEN word.id
        END) AS new_words
    FROM filtered_exposure
    JOIN immersion_word_occurrence AS occurrence
        ON occurrence.source_unit_id = filtered_exposure.source_unit_id
    JOIN immersion_word AS word ON word.id = occurrence.word_id
    WHERE word.excluded = 0
),
character_metrics AS (
    SELECT
        count(DISTINCT character.code_point) AS distinct_characters,
        count(DISTINCT CASE
            WHEN character.first_seen_at = filtered_exposure.occurred_at THEN character.code_point
        END) AS new_characters,
        count(DISTINCT CASE
            WHEN EXISTS (
                SELECT 1
                FROM immersion_anki_character AS anki_character
                JOIN immersion_anki_snapshot AS snapshot
                    ON snapshot.id = anki_character.snapshot_id
                WHERE
                    snapshot.is_current = 1
                    AND (:filterProfileIds = 0 OR snapshot.profile_id IN :profileIds)
                    AND anki_character.code_point = character.code_point
            ) THEN character.code_point
        END) AS characters_in_anki
    FROM filtered_exposure
    JOIN immersion_character_occurrence AS occurrence
        ON occurrence.source_unit_id = filtered_exposure.source_unit_id
    JOIN immersion_character AS character
        ON character.code_point = occurrence.character_code_point
)
SELECT
    coalesce(character_metrics.distinct_characters, 0) AS distinct_characters,
    coalesce(character_metrics.new_characters, 0) AS new_characters,
    coalesce(word_metrics.unique_words, 0) AS unique_words,
    coalesce(word_metrics.new_words, 0) AS new_words,
    coalesce(character_metrics.characters_in_anki, 0) AS characters_in_anki
FROM word_metrics, character_metrics;

selectImmersionAnalyticsTitleInventory:
WITH filtered_exposure AS (
    SELECT DISTINCT
        exposure.source_unit_id,
        event.occurred_at,
        session.title_id
    FROM immersion_source_exposure AS exposure
    JOIN immersion_event AS event ON event.id = exposure.event_id
    JOIN immersion_session AS session ON session.id = event.session_id
    WHERE
        session.status != 'DELETED'
        AND (
            :filterDate = 0
            OR event.local_date BETWEEN :startDate AND :endDate
        )
        AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
        AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
        AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
        AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
        AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
        AND (:includeLegacy = 1 OR session.legacy_import = 0)
        AND (
            :filterProvenance = 0
            OR (
                session.legacy_import = 1
                AND 'LEGACY_AGGREGATE' IN :provenanceStates
            )
            OR (
                session.legacy_import = 0
                AND 'AVAILABLE' IN :provenanceStates
            )
        )
),
titles AS (
    SELECT DISTINCT title_id FROM filtered_exposure
),
word_metrics AS (
    SELECT
        filtered_exposure.title_id,
        count(DISTINCT word.id) AS unique_words,
        count(DISTINCT CASE
            WHEN word.first_seen_at = filtered_exposure.occurred_at THEN word.id
        END) AS new_words
    FROM filtered_exposure
    JOIN immersion_word_occurrence AS occurrence
        ON occurrence.source_unit_id = filtered_exposure.source_unit_id
    JOIN immersion_word AS word ON word.id = occurrence.word_id
    WHERE word.excluded = 0
    GROUP BY filtered_exposure.title_id
),
character_metrics AS (
    SELECT
        filtered_exposure.title_id,
        count(DISTINCT character.code_point) AS distinct_characters,
        count(DISTINCT CASE
            WHEN character.first_seen_at = filtered_exposure.occurred_at THEN character.code_point
        END) AS new_characters,
        count(DISTINCT CASE
            WHEN EXISTS (
                SELECT 1
                FROM immersion_anki_character AS anki_character
                JOIN immersion_anki_snapshot AS snapshot
                    ON snapshot.id = anki_character.snapshot_id
                WHERE
                    snapshot.is_current = 1
                    AND (:filterProfileIds = 0 OR snapshot.profile_id IN :profileIds)
                    AND anki_character.code_point = character.code_point
            ) THEN character.code_point
        END) AS characters_in_anki
    FROM filtered_exposure
    JOIN immersion_character_occurrence AS occurrence
        ON occurrence.source_unit_id = filtered_exposure.source_unit_id
    JOIN immersion_character AS character
        ON character.code_point = occurrence.character_code_point
    GROUP BY filtered_exposure.title_id
)
SELECT
    titles.title_id,
    coalesce(character_metrics.distinct_characters, 0) AS distinct_characters,
    coalesce(character_metrics.new_characters, 0) AS new_characters,
    coalesce(word_metrics.unique_words, 0) AS unique_words,
    coalesce(word_metrics.new_words, 0) AS new_words,
    coalesce(character_metrics.characters_in_anki, 0) AS characters_in_anki
FROM titles
LEFT JOIN word_metrics ON word_metrics.title_id = titles.title_id
LEFT JOIN character_metrics ON character_metrics.title_id = titles.title_id
ORDER BY titles.title_id;

selectImmersionAnalyticsTitleMetadata:
SELECT
    id,
    display_title,
    media_kind,
    language_tag,
    total_units,
    total_character_estimate,
    CASE
        WHEN status IN ('COMPLETED', 'FINISHED', 'READ') THEN 1
        WHEN status IS NULL THEN -1
        ELSE 0
    END AS completed
FROM immersion_title
WHERE id IN :titleIds
ORDER BY id;

selectImmersionRollupEvents:
SELECT
    event.id AS event_id,
    event.occurred_at,
    event.timezone_offset_seconds,
    event.active_duration_delta_ms,
    event.gross_character_delta,
    event.unique_source_character_delta,
    event.net_character_delta,
    CASE WHEN lookup.status = 'SUCCESS' THEN 1 ELSE 0 END AS successful_lookup_delta,
    event.cards_created_delta,
    event.cards_updated_delta,
    coalesce(exposure.replay_ordinal, 0) AS replay_ordinal,
    session.title_id,
    session.media_kind,
    session.profile_id,
    session.language_tag,
    session.legacy_import
FROM immersion_event AS event
JOIN immersion_session AS session ON session.id = event.session_id
LEFT JOIN immersion_lookup AS lookup ON lookup.event_id = event.id
LEFT JOIN immersion_source_exposure AS exposure ON exposure.event_id = event.id
WHERE
    event.occurred_at >= :fromEpochMillis
    AND event.occurred_at < :untilEpochMillis
    AND session.status != 'DELETED'
ORDER BY event.occurred_at, event.id;

selectImmersionRollupSessions:
SELECT *
FROM immersion_session
WHERE
    started_at >= :fromEpochMillis
    AND started_at < :untilEpochMillis
    AND status != 'DELETED'
ORDER BY started_at, id;

selectImmersionRollupSourceFacts:
SELECT
    event.id AS event_id,
    event.source_unit_id,
    event.occurred_at,
    event.timezone_offset_seconds,
    exposure.replay_ordinal,
    session.title_id,
    session.media_kind,
    session.profile_id,
    session.language_tag,
    session.legacy_import,
    source.indexing_status,
    source.raw_text IS NOT NULL AS has_raw_text,
    source.ocr_engine_id IS NOT NULL AS is_ocr
FROM immersion_event AS event
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_source_exposure AS exposure ON exposure.event_id = event.id
JOIN immersion_source_unit AS source ON source.id = event.source_unit_id
WHERE
    event.occurred_at >= :fromEpochMillis
    AND event.occurred_at < :untilEpochMillis
    AND session.status != 'DELETED'
ORDER BY event.occurred_at, event.id;

selectImmersionRollupWordFacts:
SELECT
    event.id AS event_id,
    event.occurred_at,
    event.timezone_offset_seconds,
    exposure.replay_ordinal,
    session.title_id,
    session.media_kind,
    session.profile_id,
    session.language_tag,
    session.legacy_import,
    word.id AS word_id,
    word.first_seen_at,
    count(*) AS occurrence_count
FROM immersion_event AS event
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_source_exposure AS exposure ON exposure.event_id = event.id
JOIN immersion_word_occurrence AS occurrence ON occurrence.source_unit_id = event.source_unit_id
JOIN immersion_word AS word ON word.id = occurrence.word_id AND word.excluded = 0
WHERE
    event.occurred_at >= :fromEpochMillis
    AND event.occurred_at < :untilEpochMillis
    AND session.status != 'DELETED'
GROUP BY event.id, word.id
ORDER BY event.occurred_at, event.id, word.id;

selectImmersionRollupCharacterFacts:
SELECT
    event.id AS event_id,
    event.occurred_at,
    event.timezone_offset_seconds,
    exposure.replay_ordinal,
    session.title_id,
    session.media_kind,
    session.profile_id,
    session.language_tag,
    session.legacy_import,
    occurrence.character_code_point,
    character.first_seen_at,
    occurrence.occurrence_count
FROM immersion_event AS event
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_source_exposure AS exposure ON exposure.event_id = event.id
JOIN immersion_character_occurrence AS occurrence ON occurrence.source_unit_id = event.source_unit_id
JOIN immersion_character AS character ON character.code_point = occurrence.character_code_point
WHERE
    event.occurred_at >= :fromEpochMillis
    AND event.occurred_at < :untilEpochMillis
    AND session.status != 'DELETED'
ORDER BY event.occurred_at, event.id, occurrence.character_code_point;

deleteImmersionDailyRollupsInRange:
DELETE FROM immersion_daily_rollup
WHERE local_date BETWEEN :startDate AND :endDate;

insertImmersionDailyRollup:
INSERT INTO immersion_daily_rollup(
    scope_key,
    local_date,
    profile_id,
    language_tag,
    media_kind,
    title_id,
    active_duration_ms,
    gross_characters,
    unique_source_characters,
    net_characters,
    source_units,
    words,
    unique_words,
    new_words,
    distinct_characters,
    new_characters,
    sessions,
    lookups,
    cards_created,
    cards_updated,
    provenance_state,
    replay_state,
    rollup_version,
    last_applied_event_at
)
VALUES (
    :scopeKey,
    :localDate,
    :profileId,
    :languageTag,
    :mediaKind,
    :titleId,
    :activeDurationMs,
    :grossCharacters,
    :uniqueSourceCharacters,
    :netCharacters,
    :sourceUnits,
    :words,
    :uniqueWords,
    :newWords,
    :distinctCharacters,
    :newCharacters,
    :sessions,
    :lookups,
    :cardsCreated,
    :cardsUpdated,
    :provenanceState,
    :replayState,
    :rollupVersion,
    :lastAppliedEventAt
);

rebuildImmersionLifetimeRollups:
INSERT INTO immersion_lifetime_rollup(
    scope_key,
    profile_id,
    language_tag,
    media_kind,
    title_id,
    active_duration_ms,
    gross_characters,
    unique_source_characters,
    net_characters,
    source_units,
    words,
    unique_words,
    distinct_characters,
    sessions,
    lookups,
    cards_created,
    cards_updated,
    provenance_state,
    replay_state,
    rollup_version,
    updated_at
)
SELECT
    profile_id || char(31) || language_tag || char(31) || media_kind ||
        char(31) || title_id || char(31) || provenance_state ||
        char(31) || replay_state,
    profile_id,
    language_tag,
    media_kind,
    title_id,
    sum(active_duration_ms),
    sum(gross_characters),
    sum(unique_source_characters),
    sum(net_characters),
    sum(source_units),
    sum(words),
    sum(unique_words),
    sum(distinct_characters),
    sum(sessions),
    sum(lookups),
    sum(cards_created),
    sum(cards_updated),
    provenance_state,
    replay_state,
    :rollupVersion,
    :updatedAt
FROM immersion_daily_rollup
GROUP BY profile_id, language_tag, media_kind, title_id, provenance_state, replay_state;

insertImmersionAppliedEvent:
INSERT OR REPLACE INTO immersion_applied_event(event_id, rollup_version, applied_at)
VALUES (:eventId, :rollupVersion, :appliedAt);

deleteImmersionAppliedEventsInRange:
DELETE FROM immersion_applied_event
WHERE event_id IN (
    SELECT id
    FROM immersion_event
    WHERE
        local_date BETWEEN :startDate AND :endDate
);

selectImmersionDirtyRollupRanges:
SELECT local_date, title_id, reason, updated_at
FROM immersion_rollup_dirty
ORDER BY local_date, title_id, reason
LIMIT :limit;

upsertImmersionRollupDirty:
INSERT INTO immersion_rollup_dirty(local_date, title_id, reason, updated_at)
VALUES (:localDate, :titleId, :reason, :updatedAt)
ON CONFLICT(local_date, title_id, reason) DO UPDATE SET
    updated_at = max(updated_at, excluded.updated_at);

deleteImmersionDirtyRollupRange:
DELETE FROM immersion_rollup_dirty
WHERE local_date BETWEEN :startDate AND :endDate;

selectImmersionAnalyticsQuality:
SELECT
    count(DISTINCT CASE WHEN session.legacy_import = 1 THEN session.id END) AS legacy_sessions,
    count(DISTINCT CASE WHEN session.legacy_import = 0 THEN session.id END) AS event_sessions,
    count(DISTINCT source.id) AS source_units,
    count(DISTINCT CASE WHEN source.indexing_status = 'INDEXED' THEN source.id END) AS indexed_source_units,
    count(DISTINCT CASE WHEN source.raw_text IS NOT NULL THEN source.id END) AS text_source_units,
    count(DISTINCT CASE WHEN source.ocr_engine_id IS NOT NULL THEN source.id END) AS ocr_source_units,
    count(DISTINCT CASE
        WHEN source.ocr_engine_id IS NOT NULL AND source.raw_text IS NOT NULL THEN source.id
    END) AS ocr_text_source_units
FROM immersion_session AS session
LEFT JOIN immersion_event AS event ON event.session_id = session.id
LEFT JOIN immersion_source_unit AS source ON source.id = event.source_unit_id
WHERE
    session.status != 'DELETED'
    AND (
        :filterDate = 0 OR
        coalesce(
            session.legacy_local_date,
            (session.started_at + session.start_offset_seconds * 1000) / 86400000
        ) BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
    AND (:includeLegacy = 1 OR session.legacy_import = 0)
    AND (
        :filterProvenance = 0
        OR (
            session.legacy_import = 1
            AND 'LEGACY_AGGREGATE' IN :provenanceStates
        )
        OR (
            session.legacy_import = 0
            AND 'AVAILABLE' IN :provenanceStates
        )
    );

selectImmersionAnalyticsWords:
SELECT
    word.id,
    word.language_tag,
    word.display_headword,
    word.display_reading,
    word.part_of_speech,
    count(*) AS occurrence_count,
    count(DISTINCT session.title_id) AS title_count,
    word.first_seen_at,
    word.last_seen_at,
    word.frequency_rank,
    coalesce(
        (
            SELECT item.maturity_tier
            FROM immersion_anki_item AS item
            JOIN immersion_anki_snapshot AS snapshot ON snapshot.id = item.snapshot_id
            WHERE
                snapshot.is_current = 1
                AND (:filterProfileIds = 0 OR snapshot.profile_id IN :profileIds)
                AND item.language_tag = word.language_tag
                AND item.normalized_word = word.normalized_headword
                AND (
                    item.normalized_reading = word.normalized_reading
                    OR item.normalized_reading = ''
                )
            ORDER BY
                CASE item.maturity_tier
                    WHEN 'MATURE' THEN 5
                    WHEN 'YOUNG' THEN 4
                    WHEN 'LEARNING' THEN 3
                    WHEN 'NEW' THEN 2
                    ELSE 1
                END DESC,
                item.card_id
            LIMIT 1
        ),
        'UNKNOWN'
    ) AS maturity_tier,
    coalesce(
        (
            SELECT item.match_confidence
            FROM immersion_anki_item AS item
            JOIN immersion_anki_snapshot AS snapshot ON snapshot.id = item.snapshot_id
            WHERE
                snapshot.is_current = 1
                AND (:filterProfileIds = 0 OR snapshot.profile_id IN :profileIds)
                AND item.language_tag = word.language_tag
                AND item.normalized_word = word.normalized_headword
            ORDER BY
                CASE item.match_confidence
                    WHEN 'READING_AWARE' THEN 3
                    WHEN 'HEADWORD_ONLY' THEN 2
                    ELSE 1
                END DESC,
                item.card_id
            LIMIT 1
        ),
        ''
    ) AS match_confidence
FROM immersion_word AS word
JOIN immersion_word_occurrence AS occurrence ON occurrence.word_id = word.id
JOIN immersion_source_exposure AS exposure ON exposure.source_unit_id = occurrence.source_unit_id
JOIN immersion_event AS event ON event.id = exposure.event_id
JOIN immersion_session AS session ON session.id = event.session_id
WHERE
    word.excluded = 0
    AND (
        :searchQuery = ''
        OR word.display_headword LIKE '%' || :searchQuery || '%' COLLATE NOCASE
        OR coalesce(word.display_reading, '') LIKE '%' || :searchQuery || '%' COLLATE NOCASE
        OR coalesce(word.part_of_speech, '') LIKE '%' || :searchQuery || '%' COLLATE NOCASE
    )
    AND (
        :filterDate = 0 OR
        event.local_date BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR word.language_tag IN :languageTags)
    AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
    AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
    AND (:includeLegacy = 1 OR session.legacy_import = 0)
    AND (
        :filterProvenance = 0
        OR (
            session.legacy_import = 1
            AND 'LEGACY_AGGREGATE' IN :provenanceStates
        )
        OR (
            session.legacy_import = 0
            AND 'AVAILABLE' IN :provenanceStates
        )
    )
    AND (
        :filterMaturity = 0
        OR EXISTS (
            SELECT 1
            FROM immersion_anki_item AS maturity_item
            JOIN immersion_anki_snapshot AS maturity_snapshot
                ON maturity_snapshot.id = maturity_item.snapshot_id
            WHERE
                maturity_snapshot.is_current = 1
                AND (:filterProfileIds = 0 OR maturity_snapshot.profile_id IN :profileIds)
                AND maturity_item.language_tag = word.language_tag
                AND maturity_item.normalized_word = word.normalized_headword
                AND maturity_item.maturity_tier IN :maturityTiers
        )
        OR (
            'UNKNOWN' IN :maturityTiers
            AND NOT EXISTS (
                SELECT 1
                FROM immersion_anki_item AS unknown_item
                JOIN immersion_anki_snapshot AS unknown_snapshot
                    ON unknown_snapshot.id = unknown_item.snapshot_id
                WHERE
                    unknown_snapshot.is_current = 1
                    AND (:filterProfileIds = 0 OR unknown_snapshot.profile_id IN :profileIds)
                    AND unknown_item.language_tag = word.language_tag
                    AND unknown_item.normalized_word = word.normalized_headword
            )
        )
    )
GROUP BY word.id
ORDER BY
    CASE WHEN :sort = 'MOST_OCCURRENCES' THEN occurrence_count END DESC,
    CASE WHEN :sort = 'MOST_RECENT' THEN word.last_seen_at END DESC,
    CASE WHEN :sort = 'FIRST_SEEN' THEN word.first_seen_at END,
    CASE WHEN :sort = 'ALPHABETICAL' THEN word.display_headword END,
    CASE WHEN :sort = 'FREQUENCY_RANK' THEN word.frequency_rank IS NULL END,
    CASE WHEN :sort = 'FREQUENCY_RANK' THEN word.frequency_rank END,
    CASE WHEN :sort = 'MOST_CHARACTERS' THEN length(word.display_headword) END DESC,
    word.id
LIMIT :limit
OFFSET :offset;

selectImmersionAnalyticsCharacters:
SELECT
    character.code_point,
    character.rendered,
    character.unicode_name,
    character.unicode_script,
    sum(occurrence.occurrence_count) AS occurrence_count,
    (
        SELECT count(DISTINCT word_occurrence.word_id)
        FROM immersion_character_occurrence AS character_occurrence
        JOIN immersion_word_occurrence AS word_occurrence
            ON word_occurrence.source_unit_id = character_occurrence.source_unit_id
        WHERE character_occurrence.character_code_point = character.code_point
    ) AS word_count,
    count(DISTINCT session.title_id) AS title_count,
    character.first_seen_at,
    character.last_seen_at,
    character.frequency_rank,
    coalesce(
        (
            SELECT item.maturity_tier
            FROM immersion_anki_character AS anki_character
            JOIN immersion_anki_item AS item
                ON item.snapshot_id = anki_character.snapshot_id
                AND item.card_id = anki_character.card_id
            JOIN immersion_anki_snapshot AS snapshot ON snapshot.id = item.snapshot_id
            WHERE
                snapshot.is_current = 1
                AND (:filterProfileIds = 0 OR snapshot.profile_id IN :profileIds)
                AND anki_character.code_point = character.code_point
            ORDER BY
                CASE item.maturity_tier
                    WHEN 'MATURE' THEN 5
                    WHEN 'YOUNG' THEN 4
                    WHEN 'LEARNING' THEN 3
                    WHEN 'NEW' THEN 2
                    ELSE 1
                END DESC,
                item.card_id
            LIMIT 1
        ),
        'UNKNOWN'
    ) AS maturity_tier
FROM immersion_character AS character
JOIN immersion_character_occurrence AS occurrence
    ON occurrence.character_code_point = character.code_point
JOIN immersion_source_exposure AS exposure ON exposure.source_unit_id = occurrence.source_unit_id
JOIN immersion_event AS event ON event.id = exposure.event_id
JOIN immersion_session AS session ON session.id = event.session_id
WHERE
    (
        :searchQuery = ''
        OR character.rendered = :searchQuery
        OR printf('U+%04X', character.code_point) LIKE '%' || upper(:searchQuery) || '%'
        OR coalesce(character.unicode_name, '') LIKE '%' || :searchQuery || '%' COLLATE NOCASE
        OR character.unicode_script LIKE '%' || :searchQuery || '%' COLLATE NOCASE
    )
    AND
    (
        :filterDate = 0 OR
        event.local_date BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
    AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
    AND (:includeLegacy = 1 OR session.legacy_import = 0)
    AND (
        :filterProvenance = 0
        OR (
            session.legacy_import = 1
            AND 'LEGACY_AGGREGATE' IN :provenanceStates
        )
        OR (
            session.legacy_import = 0
            AND 'AVAILABLE' IN :provenanceStates
        )
    )
    AND (
        :filterMaturity = 0
        OR EXISTS (
            SELECT 1
            FROM immersion_anki_character AS maturity_character
            JOIN immersion_anki_item AS maturity_item
                ON maturity_item.snapshot_id = maturity_character.snapshot_id
                AND maturity_item.card_id = maturity_character.card_id
            JOIN immersion_anki_snapshot AS maturity_snapshot
                ON maturity_snapshot.id = maturity_item.snapshot_id
            WHERE
                maturity_snapshot.is_current = 1
                AND (:filterProfileIds = 0 OR maturity_snapshot.profile_id IN :profileIds)
                AND maturity_character.code_point = character.code_point
                AND maturity_item.maturity_tier IN :maturityTiers
        )
        OR (
            'UNKNOWN' IN :maturityTiers
            AND NOT EXISTS (
                SELECT 1
                FROM immersion_anki_character AS unknown_character
                JOIN immersion_anki_item AS unknown_item
                    ON unknown_item.snapshot_id = unknown_character.snapshot_id
                    AND unknown_item.card_id = unknown_character.card_id
                JOIN immersion_anki_snapshot AS unknown_snapshot
                    ON unknown_snapshot.id = unknown_item.snapshot_id
                WHERE
                    unknown_snapshot.is_current = 1
                    AND (:filterProfileIds = 0 OR unknown_snapshot.profile_id IN :profileIds)
                    AND unknown_character.code_point = character.code_point
            )
        )
    )
GROUP BY character.code_point
ORDER BY
    CASE WHEN :sort = 'MOST_OCCURRENCES' THEN occurrence_count END DESC,
    CASE WHEN :sort = 'MOST_RECENT' THEN character.last_seen_at END DESC,
    CASE WHEN :sort = 'FIRST_SEEN' THEN character.first_seen_at END,
    CASE WHEN :sort = 'ALPHABETICAL' THEN character.rendered END,
    CASE WHEN :sort = 'FREQUENCY_RANK' THEN character.frequency_rank IS NULL END,
    CASE WHEN :sort = 'FREQUENCY_RANK' THEN character.frequency_rank END,
    CASE WHEN :sort = 'MOST_CHARACTERS' THEN occurrence_count END DESC,
    character.code_point
LIMIT :limit
OFFSET :offset;

selectImmersionAnalyticsSessionsFirstPage:
SELECT *
FROM immersion_session
WHERE
    status != 'DELETED'
    AND (
        :filterDate = 0 OR
        coalesce(
            legacy_local_date,
            (started_at + start_offset_seconds * 1000) / 86400000
        ) BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR title_id IN :titleIds)
    AND (:includeLegacy = 1 OR legacy_import = 0)
    AND (
        :filterProvenance = 0
        OR (
            legacy_import = 1
            AND 'LEGACY_AGGREGATE' IN :provenanceStates
        )
        OR (
            legacy_import = 0
            AND 'AVAILABLE' IN :provenanceStates
        )
    )
ORDER BY started_at DESC, id DESC
LIMIT :limit;

selectImmersionAnalyticsSessionsAfter:
SELECT *
FROM immersion_session
WHERE
    status != 'DELETED'
    AND (started_at < :beforeStartedAt OR (started_at = :beforeStartedAt AND id < :beforeId))
    AND (
        :filterDate = 0 OR
        coalesce(
            legacy_local_date,
            (started_at + start_offset_seconds * 1000) / 86400000
        ) BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR title_id IN :titleIds)
    AND (:includeLegacy = 1 OR legacy_import = 0)
    AND (
        :filterProvenance = 0
        OR (
            legacy_import = 1
            AND 'LEGACY_AGGREGATE' IN :provenanceStates
        )
        OR (
            legacy_import = 0
            AND 'AVAILABLE' IN :provenanceStates
        )
    )
ORDER BY started_at DESC, id DESC
LIMIT :limit;

selectImmersionAnalyticsSessionEvents:
SELECT
    event.occurred_at,
    event.type,
    event.active_duration_delta_ms,
    event.gross_character_delta,
    event.unique_source_character_delta,
    event.net_character_delta,
    event.lookup_delta,
    event.cards_created_delta,
    event.cards_updated_delta,
    source.id AS source_unit_id,
    source.source_kind,
    source.canonical_locator,
    source.raw_text IS NOT NULL AS raw_text_available,
    source.raw_text,
    title.display_title,
    session.title_id,
    session.media_kind
FROM immersion_event AS event
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_title AS title ON title.id = session.title_id
LEFT JOIN immersion_source_unit AS source ON source.id = event.source_unit_id
WHERE event.session_id = :sessionId
ORDER BY event.occurred_at, event.sequence;

selectImmersionAnalyticsSourceSearch:
SELECT
    source.id AS source_unit_id,
    source.title_id,
    title.display_title,
    session.id AS session_id,
    session.media_kind,
    source.source_kind,
    source.canonical_locator,
    min(event.occurred_at) AS occurred_at,
    substr(CAST(source.raw_text AS TEXT), 1, 240) AS excerpt,
    1 AS raw_text_available
FROM immersion_source_fts
JOIN immersion_source_unit AS source
    ON source.id = immersion_source_fts.source_unit_id
JOIN immersion_source_exposure AS exposure ON exposure.source_unit_id = source.id
JOIN immersion_event AS event ON event.id = exposure.event_id
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_title AS title ON title.id = source.title_id
WHERE
    immersion_source_fts MATCH :ftsQuery
    AND session.status != 'DELETED'
    AND (
        :filterDate = 0
        OR event.local_date BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
    AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
    AND (:includeLegacy = 1 OR session.legacy_import = 0)
GROUP BY source.id, session.id
ORDER BY occurred_at DESC, source.id, session.id
LIMIT :limit
OFFSET :offset;

selectImmersionAnalyticsWordOccurrences:
SELECT
    source.id AS source_unit_id,
    source.title_id,
    title.display_title,
    session.id AS session_id,
    session.media_kind,
    source.source_kind,
    source.canonical_locator,
    min(event.occurred_at) AS occurred_at,
    source.raw_text,
    occurrence.surface_text,
    source.raw_text IS NOT NULL AS raw_text_available
FROM immersion_word_occurrence AS occurrence
JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
JOIN immersion_source_exposure AS exposure ON exposure.source_unit_id = source.id
JOIN immersion_event AS event ON event.id = exposure.event_id
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_title AS title ON title.id = source.title_id
WHERE
    occurrence.word_id = :wordId
    AND session.status != 'DELETED'
    AND (
        :filterDate = 0
        OR event.local_date BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
    AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
    AND (:includeLegacy = 1 OR session.legacy_import = 0)
GROUP BY source.id, session.id
ORDER BY occurred_at DESC, source.id, session.id
LIMIT :limit
OFFSET :offset;

selectImmersionAnalyticsCharacterOccurrences:
SELECT
    source.id AS source_unit_id,
    source.title_id,
    title.display_title,
    session.id AS session_id,
    session.media_kind,
    source.source_kind,
    source.canonical_locator,
    min(event.occurred_at) AS occurred_at,
    source.raw_text,
    source.raw_text IS NOT NULL AS raw_text_available
FROM immersion_character_occurrence AS occurrence
JOIN immersion_source_unit AS source ON source.id = occurrence.source_unit_id
JOIN immersion_source_exposure AS exposure ON exposure.source_unit_id = source.id
JOIN immersion_event AS event ON event.id = exposure.event_id
JOIN immersion_session AS session ON session.id = event.session_id
JOIN immersion_title AS title ON title.id = source.title_id
WHERE
    occurrence.character_code_point = :codePoint
    AND session.status != 'DELETED'
    AND (
        :filterDate = 0
        OR event.local_date BETWEEN :startDate AND :endDate
    )
    AND (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
    AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
    AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
    AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
    AND (:includeRereads = 1 OR exposure.replay_ordinal = 0)
    AND (:includeLegacy = 1 OR session.legacy_import = 0)
GROUP BY source.id, session.id
ORDER BY occurred_at DESC, source.id, session.id
LIMIT :limit
OFFSET :offset;

selectImmersionImportLedger:
SELECT *
FROM immersion_import_ledger
WHERE
    source_key = :sourceKey
    AND source_version = :sourceVersion
    AND content_hash = :contentHash;

insertImmersionImportLedger:
INSERT INTO immersion_import_ledger(
    source_key,
    source_version,
    content_hash,
    imported_at,
    result,
    imported_count,
    skipped_count,
    failed_count,
    error_code
)
VALUES (
    :sourceKey,
    :sourceVersion,
    :contentHash,
    :importedAt,
    :result,
    :importedCount,
    :skippedCount,
    :failedCount,
    :errorCode
);

selectLegacyImmersionAggregates:
SELECT
    legacy_local_date,
    media_kind,
    profile_id,
    language_tag,
    title_id,
    sum(active_duration_ms) AS active_duration_ms,
    sum(gross_characters) AS characters,
    sum(legacy_cards_total) AS cards_total,
    count(*) AS record_count
FROM immersion_session
WHERE legacy_import = 1
GROUP BY legacy_local_date, media_kind, profile_id, language_tag, title_id
ORDER BY legacy_local_date DESC, media_kind, profile_id, language_tag, title_id;

upsertImmersionGoal:
INSERT INTO immersion_goal(
    id,
    type,
    metric,
    target,
    period,
    start_date,
    end_date,
    media_kind,
    profile_id,
    language_tag,
    title_id,
    weekday_multipliers,
    rest_day_policy,
    state,
    created_at,
    updated_at
)
VALUES (
    :id,
    :type,
    :metric,
    :target,
    :period,
    :startDate,
    :endDate,
    :mediaKind,
    :profileId,
    :languageTag,
    :titleId,
    :weekdayMultipliers,
    :restDayPolicy,
    :state,
    :createdAt,
    :updatedAt
)
ON CONFLICT(id) DO UPDATE SET
    target = excluded.target,
    end_date = excluded.end_date,
    weekday_multipliers = excluded.weekday_multipliers,
    rest_day_policy = excluded.rest_day_policy,
    state = excluded.state,
    updated_at = excluded.updated_at;

selectImmersionGoals:
SELECT *
FROM immersion_goal
ORDER BY updated_at DESC, id DESC;

upsertImmersionGoalCheckIn:
INSERT INTO immersion_goal_check_in(
    goal_id,
    local_date,
    status,
    note,
    occurred_at
)
VALUES (:goalId, :localDate, :status, :note, :occurredAt)
ON CONFLICT(goal_id, local_date) DO UPDATE SET
    status = excluded.status,
    note = excluded.note,
    occurred_at = excluded.occurred_at;

selectImmersionGoalCheckIns:
SELECT *
FROM immersion_goal_check_in
WHERE goal_id = :goalId
ORDER BY local_date, occurred_at;

insertImmersionGoalAchievement:
INSERT OR IGNORE INTO immersion_goal_achievement(
    id,
    goal_id,
    milestone_key,
    earned_at,
    target_snapshot
)
VALUES (:id, :goalId, :milestoneKey, :earnedAt, :targetSnapshot);

selectImmersionGoalAchievements:
SELECT *
FROM immersion_goal_achievement
WHERE goal_id = :goalId
ORDER BY earned_at, id;

upsertImmersionAnkiSnapshot:
INSERT INTO immersion_anki_snapshot(
    id,
    profile_id,
    deck_scope,
    requested_at,
    completed_at,
    capability_version,
    capability_state,
    provider_version,
    supports_note_modification,
    supports_card_modification,
    supports_review_history,
    status,
    error_code,
    item_count,
    note_count,
    mature_interval_days,
    mapping_hash,
    query_duration_ms,
    is_complete,
    is_partial,
    is_current,
    is_stale
)
VALUES (
    :id,
    :profileId,
    :deckScope,
    :requestedAt,
    :completedAt,
    :capabilityVersion,
    :capabilityState,
    :providerVersion,
    :supportsNoteModification,
    :supportsCardModification,
    :supportsReviewHistory,
    :status,
    :errorCode,
    :itemCount,
    :noteCount,
    :matureIntervalDays,
    :mappingHash,
    :queryDurationMillis,
    :isComplete,
    :isPartial,
    :isCurrent,
    :isStale
)
ON CONFLICT(id) DO UPDATE SET
    completed_at = excluded.completed_at,
    capability_state = excluded.capability_state,
    provider_version = excluded.provider_version,
    supports_note_modification = excluded.supports_note_modification,
    supports_card_modification = excluded.supports_card_modification,
    supports_review_history = excluded.supports_review_history,
    status = excluded.status,
    error_code = excluded.error_code,
    item_count = excluded.item_count,
    note_count = excluded.note_count,
    mature_interval_days = excluded.mature_interval_days,
    mapping_hash = excluded.mapping_hash,
    query_duration_ms = excluded.query_duration_ms,
    is_complete = excluded.is_complete,
    is_partial = excluded.is_partial,
    is_current = excluded.is_current,
    is_stale = excluded.is_stale;

clearCurrentImmersionAnkiSnapshot:
UPDATE immersion_anki_snapshot
SET is_current = 0,
    is_stale = 1
WHERE profile_id = :profileId
  AND is_current = 1;

markCurrentImmersionAnkiSnapshotStale:
UPDATE immersion_anki_snapshot
SET is_stale = 1
WHERE profile_id = :profileId
  AND is_current = 1;

setCurrentImmersionAnkiSnapshot:
UPDATE immersion_anki_snapshot
SET is_current = 1,
    is_stale = 0
WHERE id = :snapshotId;

deleteImmersionAnkiSnapshotItems:
DELETE FROM immersion_anki_item
WHERE snapshot_id = :snapshotId;

insertImmersionAnkiItem:
INSERT INTO immersion_anki_item(
    snapshot_id,
    note_id,
    card_id,
    note_type_id,
    deck_id,
    language_tag,
    normalized_word,
    normalized_reading,
    card_type,
    queue,
    interval_days,
    due,
    repetitions,
    lapses,
    ease,
    note_modified_at,
    match_confidence,
    ambiguity_count,
    maturity_tier,
    first_mature_at
)
VALUES (
    :snapshotId,
    :noteId,
    :cardId,
    :noteTypeId,
    :deckId,
    :languageTag,
    :normalizedWord,
    :normalizedReading,
    :cardType,
    :queue,
    :intervalDays,
    :due,
    :repetitions,
    :lapses,
    :ease,
    :noteModifiedAt,
    :matchConfidence,
    :ambiguityCount,
    :maturityTier,
    :firstMatureAt
);

insertImmersionAnkiCharacter:
INSERT INTO immersion_anki_character(snapshot_id, card_id, code_point)
VALUES (:snapshotId, :cardId, :codePoint);

selectCurrentImmersionAnkiSnapshot:
SELECT *
FROM immersion_anki_snapshot
WHERE profile_id = :profileId
  AND is_current = 1
LIMIT 1;

selectLatestImmersionAnkiSnapshot:
SELECT *
FROM immersion_anki_snapshot
WHERE profile_id = :profileId
ORDER BY requested_at DESC, id DESC
LIMIT 1;

selectCurrentImmersionAnkiItems:
SELECT item.*
FROM immersion_anki_item AS item
JOIN immersion_anki_snapshot AS snapshot
  ON snapshot.id = item.snapshot_id
WHERE snapshot.profile_id = :profileId
  AND snapshot.is_current = 1
ORDER BY item.note_id, item.card_id;

selectCurrentImmersionAnkiCharacters:
SELECT character.card_id, character.code_point
FROM immersion_anki_character AS character
JOIN immersion_anki_snapshot AS snapshot
  ON snapshot.id = character.snapshot_id
WHERE snapshot.profile_id = :profileId
  AND snapshot.is_current = 1
ORDER BY character.card_id, character.code_point;

selectImmersionAnkiWordItems:
SELECT item.*
FROM immersion_anki_item AS item
JOIN immersion_anki_snapshot AS snapshot
  ON snapshot.id = item.snapshot_id
WHERE snapshot.profile_id = :profileId
  AND snapshot.is_current = 1
  AND item.language_tag = :languageTag
  AND item.normalized_word = :normalizedWord
  AND (
    :normalizedReading = ''
    OR item.normalized_reading = :normalizedReading
    OR item.normalized_reading = ''
  )
ORDER BY item.note_id, item.card_id;

selectImmersionAnkiCharacterItems:
SELECT item.*
FROM immersion_anki_item AS item
JOIN immersion_anki_snapshot AS snapshot
  ON snapshot.id = item.snapshot_id
JOIN immersion_anki_character AS character
  ON character.snapshot_id = item.snapshot_id
 AND character.card_id = item.card_id
WHERE snapshot.profile_id = :profileId
  AND snapshot.is_current = 1
  AND character.code_point = :codePoint
ORDER BY item.note_id, item.card_id;

selectImmersionAnkiCharactersForCard:
SELECT code_point
FROM immersion_anki_character
WHERE snapshot_id = :snapshotId
  AND card_id = :cardId
ORDER BY code_point;

selectImmersionAnkiWordCoverage:
WITH encountered AS (
    SELECT DISTINCT
        word.normalized_headword,
        word.normalized_reading
    FROM immersion_word AS word
    JOIN immersion_word_occurrence AS occurrence
      ON occurrence.word_id = word.id
    JOIN immersion_source_unit AS source
      ON source.id = occurrence.source_unit_id
    JOIN immersion_title AS title
      ON title.id = source.title_id
    WHERE title.profile_id = :profileId
      AND word.language_tag = :languageTag
      AND word.excluded = 0
)
SELECT
    COUNT(*) AS encountered_count,
    COALESCE(SUM(
        CASE WHEN EXISTS(
            SELECT 1
            FROM immersion_anki_item AS item
            JOIN immersion_anki_snapshot AS snapshot
              ON snapshot.id = item.snapshot_id
            WHERE snapshot.profile_id = :profileId
              AND snapshot.is_current = 1
              AND item.language_tag = :languageTag
              AND item.normalized_word = encountered.normalized_headword
              AND item.normalized_reading = encountered.normalized_reading
              AND item.match_confidence = 'READING_AWARE'
        ) THEN 1 ELSE 0 END
    ), 0) AS reading_aware_count,
    COALESCE(SUM(
        CASE WHEN EXISTS(
            SELECT 1
            FROM immersion_anki_item AS item
            JOIN immersion_anki_snapshot AS snapshot
              ON snapshot.id = item.snapshot_id
            WHERE snapshot.profile_id = :profileId
              AND snapshot.is_current = 1
              AND item.language_tag = :languageTag
              AND item.normalized_word = encountered.normalized_headword
        ) THEN 1 ELSE 0 END
    ), 0) AS headword_count
FROM encountered;

selectImmersionAnkiCharacterCoverage:
WITH encountered AS (
    SELECT DISTINCT character.code_point
    FROM immersion_character AS character
    JOIN immersion_character_occurrence AS occurrence
      ON occurrence.character_code_point = character.code_point
    JOIN immersion_source_unit AS source
      ON source.id = occurrence.source_unit_id
    JOIN immersion_title AS title
      ON title.id = source.title_id
    WHERE title.profile_id = :profileId
      AND title.language_tag = :languageTag
)
SELECT
    COUNT(*) AS encountered_count,
    COALESCE(SUM(
        CASE WHEN EXISTS(
            SELECT 1
            FROM immersion_anki_character AS anki_character
            JOIN immersion_anki_snapshot AS snapshot
              ON snapshot.id = anki_character.snapshot_id
            WHERE snapshot.profile_id = :profileId
              AND snapshot.is_current = 1
              AND anki_character.code_point = encountered.code_point
        ) THEN 1 ELSE 0 END
    ), 0) AS covered_count
FROM encountered;

selectImmersionAnkiMaturityDistribution:
SELECT
    item.maturity_tier,
    count(DISTINCT item.card_id) AS item_count
FROM immersion_anki_item AS item
JOIN immersion_anki_snapshot AS snapshot ON snapshot.id = item.snapshot_id
WHERE
    snapshot.profile_id = :profileId
    AND snapshot.is_current = 1
    AND item.language_tag = :languageTag
GROUP BY item.maturity_tier
ORDER BY item.maturity_tier;

selectImmersionAnalyticsAnkiActivity:
SELECT
    count(CASE WHEN operation.session_id IS NOT NULL AND operation.source_unit_id IS NOT NULL THEN 1 END)
        AS linked_operations,
    count(CASE WHEN operation.session_id IS NULL OR operation.source_unit_id IS NULL THEN 1 END)
        AS unattributed_operations,
    avg(CASE
        WHEN source.first_exposed_at IS NOT NULL
            AND operation.occurred_at >= source.first_exposed_at
        THEN operation.occurred_at - source.first_exposed_at
    END) AS mean_lag_millis
FROM immersion_anki_operation AS operation
LEFT JOIN immersion_event AS event ON event.id = operation.event_id
LEFT JOIN immersion_session AS session ON session.id = operation.session_id
LEFT JOIN immersion_source_unit AS source ON source.id = operation.source_unit_id
WHERE
    operation.success = 1
    AND operation.type IN ('CREATE', 'UPDATE')
    AND (
        :filterDate = 0
        OR coalesce(event.local_date, operation.occurred_at / 86400000)
            BETWEEN :startDate AND :endDate
    )
    AND (
        session.id IS NULL
        OR (
            (:filterMediaKinds = 0 OR session.media_kind IN :mediaKinds)
            AND (:filterProfileIds = 0 OR session.profile_id IN :profileIds)
            AND (:filterLanguageTags = 0 OR coalesce(session.language_tag, '') IN :languageTags)
            AND (:filterTitleIds = 0 OR session.title_id IN :titleIds)
        )
    );

recomputeCurrentImmersionAnkiMaturity:
UPDATE immersion_anki_item
SET maturity_tier = CASE
        WHEN card_type = 0 OR queue = 0 THEN 'NEW'
        WHEN card_type IN (1, 3) OR queue IN (1, 3) THEN 'LEARNING'
        WHEN card_type = 2 AND COALESCE(interval_days, 0) >= :matureIntervalDays THEN 'MATURE'
        WHEN card_type = 2 THEN 'YOUNG'
        ELSE 'UNKNOWN'
    END,
    first_mature_at = CASE
        WHEN card_type = 2
         AND COALESCE(interval_days, 0) >= :matureIntervalDays
        THEN COALESCE(first_mature_at, :recomputedAt)
        ELSE first_mature_at
    END
WHERE snapshot_id = (
    SELECT id
    FROM immersion_anki_snapshot
    WHERE profile_id = :profileId
      AND is_current = 1
);

updateCurrentImmersionAnkiMatureInterval:
UPDATE immersion_anki_snapshot
SET mature_interval_days = :matureIntervalDays
WHERE profile_id = :profileId
  AND is_current = 1;

deleteImmersionAnkiSnapshots:
DELETE FROM immersion_anki_snapshot
WHERE profile_id = :profileId;
