    :eventId,
    :sessionId,
    :sourceUnitId,
    :rawQuery,
    :queryHash,
    :normalizedHeadword,
    :normalizedReading,
    :partOfSpeech,
    :dictionaryId,
    :resultId,
    :status,
    :occurredAt
);

insertImmersionAnkiOperation:
INSERT INTO immersion_anki_operation(
