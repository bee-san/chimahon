    :cardId,
    :deckId,
    :type,
    :status,
    :success,
    :expressionHash,
    :normalizedExpression,
    :normalizedReading,
    :occurredAt,
    :errorCode
);

selectImmersionAnkiOperationById:
SELECT *
FROM immersion_anki_operation
WHERE id = :id;

insertUnlinkedImmersionAnkiOperation:
INSERT OR IGNORE INTO immersion_anki_operation(
    id,
    event_id,
    session_id,
    source_unit_id,
    note_id,
    card_id,
    deck_id,
    type,
    status,
    success,
    expression_hash,
